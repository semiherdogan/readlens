{
  "name": "pagenectar",
  "version": "0.1.0",
  "description": "Clean web content for AI agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/semiherdogan/pagenectar.git"
  },
  "homepage": "https://github.com/semiherdogan/pagenectar#readme",
  "bugs": {
    "url": "https://github.com/semiherdogan/pagenectar/issues"
  },
  "keywords": [
    "ai",
    "content-extraction",
    "lightpanda",
    "mcp",
    "readability"
  ],
  "type": "module",
  "bin": {
    "pagenectar": "dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "assets/pagenectar-cover.jpg",
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "coverage": "vitest run --coverage",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@mozilla/readability": "^0.6.0",
    "jsdom": "^30.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
